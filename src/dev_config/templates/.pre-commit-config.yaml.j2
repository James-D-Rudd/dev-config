{% set repo_contents = repo_contents | default(["python", "yaml"]) -%}

{% if repo_contents %}
repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v5.0.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer

  {% if "yaml" in repo_contents %}
      - id: check-yaml
        types: [yaml]

  - repo: https://github.com/adrienverge/yamllint
    rev: v1.38.0
    hooks:
      - id: yamllint
        args: ["."]
        types: [yaml]
  {% endif %}

  {%- if "python" in repo_contents %}

  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.3.0
    hooks:
      - id: ruff
        args: [ --fix ]
        types: [python]
      - id: ruff-format
        types: [python]

  - repo: https://github.com/pre-commit/mirrors-mypy
    rev: v1.9.0
    hooks:
      - id: mypy
        types: [python]
        additional_dependencies: [types-all]
  {% endif %}
  {% if "rust" in repo_contents %}

  - repo: local
      hooks:
        - id: cargo-fmt
          name: Cargo fmt
          entry: cargo fmt --all -- --check
          language: system
          types: [rust]
  
        - id: cargo-clippy
          name: Cargo clippy
          entry: cargo clippy --all-targets --all-features -- -D warnings
          language: system
          types: [rust]
  
        - id: cargo-check
          name: Cargo check
          entry: cargo check --all-targets --all-features
          language: system
          types: [rust]
  {% endif %}
{% endif %}
